{
  "name": "@org.metadatacenter/cedar-design-tokens",
  "version": "0.1.0-dev.20261002.dd7a4fc9",
  "description": "Shared CEDAR design primitives: typography, palettes, controls, spacing, fonts and Lucide icons",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metadatacenter/cedar-design-tokens.git"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "exports": {
    "./tokens": {
      "sass": "./_tokens.scss"
    },
    "./custom-properties.css": "./dist/custom-properties.css",
    "./fonts": {
      "sass": "./_fonts.scss"
    },
    "./fonts/regular": {
      "sass": "./fonts/_roboto-400.scss"
    },
    "./fonts/medium": {
      "sass": "./fonts/_roboto-500.scss"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./controls": {
      "sass": "./_controls.scss"
    },
    "./motion": {
      "sass": "./_motion.scss"
    },
    "./motion.css": "./dist/motion.css",
    "./patterns": {
      "sass": "./_patterns.scss"
    },
    "./validation-summary.css": "./dist/validation-summary.css",
    "./icons.svg": "./dist/icons.svg",
    "./native-choices.css": "./dist/native-choices.css",
    "./authoring": {
      "sass": "./_authoring.scss"
    },
    "./icon-contract": {
      "sass": "./_icon-contract.scss"
    },
    "./icon-contract.css": "./dist/icon-contract.css",
    "./custom-properties": {
      "sass": "./_custom-properties.scss"
    },
    "./spacing": {
      "sass": "./_spacing.scss"
    }
  },
  "files": [
    "_tokens.scss",
    "_custom-properties.scss",
    "dist/custom-properties.css",
    "license.txt",
    "README.md",
    "_fonts.scss",
    "fonts/",
    "dist/icons.js",
    "dist/icons.d.ts",
    "icons/",
    "_controls.scss",
    "dist/_icon-masks.scss",
    "_motion.scss",
    "dist/motion.css",
    "_patterns.scss",
    "UI-CONTRACTS.md",
    "dist/validation-summary.css",
    "dist/icons.svg",
    "dist/native-choices.css",
    "_authoring.scss",
    "_icon-contract.scss",
    "dist/icon-contract.css",
    "_spacing.scss"
  ],
  "scripts": {
    "build": "sass --no-source-map --style=expanded tokens.entry.scss dist/custom-properties.css && node tools/build-icons.mjs && sass --no-source-map --style=expanded motion.entry.scss dist/motion.css && sass --no-source-map --style=expanded validation-summary.entry.scss dist/validation-summary.css && sass --no-source-map --style=expanded native-choices.entry.scss dist/native-choices.css && sass --no-source-map --style=expanded icon-contract.entry.scss dist/icon-contract.css",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "format": "prettier --write \"**/*.{scss,css,json,md,mjs}\"",
    "format:check": "prettier --check \"**/*.{scss,css,json,md,mjs}\"",
    "surfaces:defaults": "node tools/build-surface-defaults.mjs"
  },
  "devDependencies": {
    "lucide-static": "1.47.0",
    "prettier": "^3.6.2",
    "sass": "^1.93.2"
  },
  "type": "module",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
