{
  "name": "@org.metadatacenter/cedar-design-tokens",
  "version": "0.1.0-dev.20260918.c8c7ac96",
  "description": "Shared CEDAR design primitives: typography, palettes, controls, spacing, fonts and Lucide icons",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metadatacenter/cedar-design-tokens.git"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "exports": {
    "./tokens": {
      "sass": "./_tokens.scss"
    },
    "./custom-properties.css": "./dist/custom-properties.css",
    "./fonts": {
      "sass": "./_fonts.scss"
    },
    "./fonts/regular": {
      "sass": "./fonts/_roboto-400.scss"
    },
    "./fonts/medium": {
      "sass": "./fonts/_roboto-500.scss"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    }
  },
  "files": [
    "_tokens.scss",
    "dist/custom-properties.css",
    "license.txt",
    "README.md",
    "_fonts.scss",
    "fonts/",
    "dist/icons.js",
    "dist/icons.d.ts",
    "icons/"
  ],
  "scripts": {
    "build": "sass --no-source-map --style=expanded tokens.entry.scss dist/custom-properties.css && node tools/build-icons.mjs",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "format": "prettier --write \"**/*.{scss,css,json,md,mjs}\"",
    "format:check": "prettier --check \"**/*.{scss,css,json,md,mjs}\""
  },
  "devDependencies": {
    "lucide-static": "1.47.0",
    "prettier": "^3.6.2",
    "sass": "^1.93.2"
  },
  "type": "module"
}
