{
  "name": "@org.metadatacenter/cedar-design-tokens",
  "version": "0.1.0-dev.20260916.964cc2a9",
  "description": "Shared CEDAR typography, palettes, semantic roles, control profiles, spacing and embedded fonts",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metadatacenter/cedar-design-tokens.git"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "exports": {
    "./tokens": {
      "sass": "./_tokens.scss"
    },
    "./custom-properties.css": "./dist/custom-properties.css",
    "./fonts": {
      "sass": "./_fonts.scss"
    }
  },
  "files": [
    "_tokens.scss",
    "dist/custom-properties.css",
    "license.txt",
    "README.md",
    "_fonts.scss",
    "fonts/"
  ],
  "scripts": {
    "build": "sass --no-source-map --style=expanded tokens.entry.scss dist/custom-properties.css",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "format": "prettier --write \"**/*.{scss,css,json,md,mjs}\"",
    "format:check": "prettier --check \"**/*.{scss,css,json,md,mjs}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "sass": "^1.93.2"
  }
}
