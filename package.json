{
  "name": "@org.metadatacenter/cedar-design-tokens",
  "version": "0.1.0-dev.20261002.dd7a4fc9",
  "description": "Shared CEDAR design primitives: typography, palettes, controls, spacing, fonts and Lucide icons",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metadatacenter/cedar-design-tokens.git"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "exports": {
    "./tokens": {
      "sass": "./scss/_tokens.scss"
    },
    "./custom-properties.css": "./dist/custom-properties.css",
    "./fonts": {
      "sass": "./scss/_fonts.scss"
    },
    "./fonts/regular": {
      "sass": "./scss/fonts/_roboto-400.scss"
    },
    "./fonts/medium": {
      "sass": "./scss/fonts/_roboto-500.scss"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./controls": {
      "sass": "./scss/_controls.scss"
    },
    "./motion": {
      "sass": "./scss/_motion.scss"
    },
    "./motion.css": "./dist/motion.css",
    "./patterns": {
      "sass": "./scss/_patterns.scss"
    },
    "./validation-summary.css": "./dist/validation-summary.css",
    "./icons.svg": "./dist/icons.svg",
    "./native-choices.css": "./dist/native-choices.css",
    "./authoring": {
      "sass": "./scss/_authoring.scss"
    },
    "./icon-contract": {
      "sass": "./scss/_icon-contract.scss"
    },
    "./icon-contract.css": "./dist/icon-contract.css",
    "./custom-properties": {
      "sass": "./scss/_custom-properties.scss"
    },
    "./spacing": {
      "sass": "./scss/_spacing.scss"
    },
    "./save-state.css": "./dist/save-state.css",
    "./tooltip.css": "./dist/tooltip.css",
    "./notice.css": "./dist/notice.css",
    "./secondary-action.css": "./dist/secondary-action.css"
  },
  "files": [
    "scss/",
    "dist/custom-properties.css",
    "license.txt",
    "README.md",
    "dist/icons.js",
    "dist/icons.d.ts",
    "icons/",
    "dist/_icon-masks.scss",
    "dist/motion.css",
    "UI-CONTRACTS.md",
    "dist/validation-summary.css",
    "dist/icons.svg",
    "dist/native-choices.css",
    "dist/icon-contract.css",
    "dist/save-state.css",
    "dist/tooltip.css",
    "dist/notice.css",
    "dist/secondary-action.css"
  ],
  "scripts": {
    "build": "node tools/build-icons.mjs && sass --no-source-map --style=expanded css:dist",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "format": "prettier --write \"**/*.{scss,css,json,md,mjs}\"",
    "format:check": "prettier --check \"**/*.{scss,css,json,md,mjs}\"",
    "surfaces:defaults": "node tools/build-surface-defaults.mjs"
  },
  "devDependencies": {
    "lucide-static": "1.47.0",
    "prettier": "^3.6.2",
    "sass": "^1.93.2"
  },
  "type": "module",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
